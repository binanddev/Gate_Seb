# Blueprint asks only for these two values. This file is not automatically loaded.
FRONTEND_URL=https://your-site.netlify.app/
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Render generates DJANGO_SECRET_KEY and supplies its own hostname automatically.
